{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "exam-paper-maker spec (schema v2)",
  "type": "object",
  "required": ["schema_version", "title", "sections", "answers", "meta", "out_pdf"],
  "definitions": {
    "source": {
      "type": "object",
      "required": ["title", "url", "accessed", "quote"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https?://"},
        "accessed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "used_for": {"type": "string"},
        "quote": {"type": "string", "minLength": 10}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 2},
    "out_pdf": {"type": "string", "minLength": 1},
    "out_md": {"type": "string"},
    "date": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "info_line": {"type": "string"},
    "note": {"type": "string"},
    "footer_left": {"type": "string"},
    "footer_right": {"type": "string"},
    "author": {"type": "string"},
    "meta": {
      "type": "object",
      "required": ["total_points", "coverage"],
      "properties": {
        "course": {"type": "string"},
        "textbook": {"type": "string"},
        "chapter": {"type": "string"},
        "duration_min": {"type": "number", "minimum": 1},
        "total_points": {"type": "number", "minimum": 1},
        "coverage": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "difficulty_target": {
          "type": "object",
          "properties": {
            "basic": {"type": "number"},
            "medium": {"type": "number"},
            "challenge": {"type": "number"}
          }
        },
        "difficulty_tolerance": {"type": "number", "minimum": 0},
        "level_bands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["range", "level"],
            "properties": {
              "range": {"type": "string"},
              "level": {"type": "string"},
              "note": {"type": "string"}
            }
          }
        },
        "band_note": {"type": "string"},
        "sources": {"type": "array", "items": {"$ref": "#/definitions/source"}},
        "error_types": {
          "type": "array",
          "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading", "items"],
        "properties": {
          "heading": {"type": "string", "minLength": 1},
          "note": {"type": "string"},
          "page_break_before": {"type": "boolean"},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text", "points", "difficulty", "topic", "answer"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1},
                "options": {"type": "array", "items": {"type": "string"}},
                "space": {"type": "number", "minimum": 0},
                "points": {"type": "number", "exclusiveMinimum": 0},
                "difficulty": {"enum": ["basic", "medium", "challenge"]},
                "topic": {"type": "string", "minLength": 1},
                "kind": {"enum": ["choice", "fill", "calc", "proof", "integrated"]},
                "time_min": {"type": "number", "exclusiveMinimum": 0},
                "answer": {"type": "string", "minLength": 1},
                "why": {"type": "string"},
                "uncertain": {"type": "boolean"},
                "proof_check": {"type": "array", "items": {"type": "string"}},
                "sources": {"type": "array", "items": {"$ref": "#/definitions/source"}},
                "rubric": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["criterion", "points"],
                    "properties": {
                      "criterion": {"type": "string"},
                      "points": {"type": "number", "exclusiveMinimum": 0}
                    }
                  }
                },
                "numeric_check": {
                  "type": "object",
                  "required": ["expr", "at", "expected"],
                  "properties": {
                    "expr": {"type": "string"},
                    "at": {"type": "array", "items": {"type": "number"}, "minItems": 1},
                    "expected": {"type": "number"},
                    "rtol": {"type": "number", "minimum": 0},
                    "atol": {"type": "number", "minimum": 0}
                  }
                },
                "math": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {"enum": ["fraction", "text"]},
                      "apply": {"type": "string"},
                      "num": {"type": "string"},
                      "den": {"type": "string"},
                      "suffix": {"type": "string"},
                      "text": {"type": "string"}
                    }
                  }
                },
                "figures": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["path"],
                    "properties": {
                      "path": {"type": "string"},
                      "width_cm": {"type": "number", "exclusiveMinimum": 0},
                      "caption": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "answers": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "subtitle": {"type": "string"},
        "auto": {"type": "boolean"},
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "heading": {"type": "string"},
              "lines": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "extra_sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "heading": {"type": "string"},
              "lines": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "verify": {
      "type": "object",
      "properties": {
        "expected_pages": {"type": "integer", "minimum": 1},
        "pages": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        },
        "must_contain": {"type": "array", "items": {"type": "string"}},
        "must_not_contain": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
